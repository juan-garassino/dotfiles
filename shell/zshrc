# uv-prefix conveniences — transparent fallbacks, never intercept `uv` itself,
# so the explicit `uv run ...` / `uv pip ...` forms always work unchanged.

# u → explicit shorthand: `u pytest -q` == `uv run pytest -q` (project-aware)
u() {
  if [ $# -eq 0 ]; then
    echo "Usage: u <cmd> [args...] — runs the command via 'uv run' in the project env"
    return 1
  fi
  uv run "$@"
}

# pip → uv pip. uv venvs ship WITHOUT pip, so bare `pip install` would die;
# uv pip targets the active venv (project .venv or ~/.venv-sandbox via autoenv).
# Escape hatch for the real binary: `command pip`.
unalias pip pip3 2>/dev/null || true   # oh-my-zsh common-aliases may alias these
pip()  { uv pip "$@" }
pip3() { uv pip "$@" }

# python → fallback only. If a real `python` is on PATH (any active venv), use
# it untouched; otherwise route through uv so bare `python` in Makefiles and
# scripts keeps working outside venvs (brew ships only python3).
python() {
  local real
  real=$(whence -p python 2>/dev/null)
  if [ -n "$real" ]; then
    "$real" "$@"
  elif [ -f "pyproject.toml" ] || [ -f "uv.lock" ]; then
    uv run python "$@"                    # project context → project env
  else
    uv run --python 3.12 python "$@"      # nowhere → ephemeral 3.12, no pollution
  fi
}

# usevenv → create or activate a uv venv (uv downloads the Python if missing)
# Usage: usevenv [python_version] [venv_name] [reset]
# Examples:
#   usevenv              → uses 3.12, creates .venv
#   usevenv 3.11         → uses 3.11, creates .venv
#   usevenv 3.12 .venv reset  → destroys and recreates .venv
usevenv() {
  local version=${1:-3.12}
  local venv_name=${2:-.venv}
  local reset=${3:-false}

  deactivate 2>/dev/null || true

  if [ "$reset" = "reset" ]; then
    echo "⚠️  Resetting $venv_name..."
    rm -rf "$venv_name"
    uv venv "$venv_name" --python "$version"
  elif [ ! -d "$venv_name" ]; then
    echo "ℹ️  Creating $venv_name with Python $version (uv-managed)..."
    uv venv "$venv_name" --python "$version"
  fi

  source "$venv_name/bin/activate"
  # Only record the version in a fresh dir — never overwrite an existing
  # .python-version (many are tracked in pull-only upstream repos).
  [ -f ".python-version" ] || echo "$version" > .python-version

  echo "▶ Using uv venv '$venv_name' (🐍 $(python --version | awk '{print $2}'))"
  echo "VIRTUAL_ENV=$VIRTUAL_ENV"
}

# envup → make this project's env from whatever manifest exists, then activate.
# pyproject/uv.lock → uv sync · requirements.txt → uv venv + install · nothing →
# bare venv. Never writes .python-version (safe inside upstream repos).
# Usage: envup [python_version]
envup() {
  local ver=${1:-}
  if [ -f "pyproject.toml" ] || [ -f "uv.lock" ]; then
    uv sync || return 1
    source .venv/bin/activate
    echo "▶ Synced + activated .venv (🐍 $(python --version 2>/dev/null | awk '{print $2}'))"
  elif [ -f "requirements.txt" ]; then
    if [ -z "$ver" ]; then
      ver=$(grep -Eo '^[0-9]+\.[0-9]+(\.[0-9]+)?' .python-version 2>/dev/null | head -1)
      ver=${ver:-3.12}
    fi
    [ -d ".venv" ] || uv venv .venv --python "$ver" || return 1
    source .venv/bin/activate
    uv pip install -r requirements.txt || return 1
    echo "▶ Built .venv from requirements.txt (🐍 $(python --version 2>/dev/null | awk '{print $2}'))"
  else
    [ -d ".venv" ] || uv venv .venv --python "${ver:-3.12}" || return 1
    source .venv/bin/activate
    echo "ℹ️  No manifest found — bare .venv (${ver:-3.12}). Add deps: uv pip install <pkg>"
  fi
}

# mysandbox → the global uv playground venv at ~/.venv-sandbox (REPL, quick
# GenAI/DS tests). Created on first use with uv (Python 3.12), seeded from
# packages/mysandbox-requirements.txt (Le Wagon base + LlamaIndex/LangGraph + ML/finance
# extras). A `.seeded` marker makes the 137-package install retry-safe.
# Usage: mysandbox [reset]
mysandbox() {
  local sandbox="$HOME/.venv-sandbox"
  local req="$HOME/Code/000-config/001-dotfiles/packages/mysandbox-requirements.txt"
  command -v uv >/dev/null 2>&1 || { echo "⚠️  uv missing — brew install uv"; return 1; }

  if [ "$1" = "reset" ]; then
    echo "⚠️  Resetting ~/.venv-sandbox..."
    rm -rf "$sandbox"
  fi
  if [ ! -f "$sandbox/bin/activate" ]; then
    echo "ℹ️  Creating ~/.venv-sandbox (uv, Python 3.12)..."
    uv venv "$sandbox" --python 3.12 || return 1
  fi
  if [ -f "$req" ] && [ ! -f "$sandbox/.seeded" ]; then
    echo "📦 Seeding from mysandbox-requirements.txt..."
    if uv pip install --python "$sandbox/bin/python" -r "$req"; then
      touch "$sandbox/.seeded"
    else
      echo "⚠️  Seed incomplete — re-run mysandbox to retry"
    fi
  fi
  deactivate 2>/dev/null || true
  source "$sandbox/bin/activate"
  [[ -o interactive ]] && echo "▶ sandbox active (🐍 $(python --version 2>/dev/null | awk '{print $2}'))"
}

# lsenvs → list uv-managed Pythons, the global sandbox, and local .venv dirs
lsenvs() {
  echo "📦 uv-managed Pythons:"
  uv python list --only-installed 2>/dev/null | sed 's/^/  - /' || echo "  - <uv not installed>"

  echo ""
  echo "🌍 Global sandbox:"
  if [ -d "$HOME/.venv-sandbox" ]; then
    local sver=$(grep -E 'version' "$HOME/.venv-sandbox/pyvenv.cfg" 2>/dev/null | sed 's/ *version[_a-z]* *= *//' | head -1)
    echo "  - ~/.venv-sandbox ($sver)"
  else
    echo "  - <none — run mysandbox to create>"
  fi

  echo ""
  echo "📂 Project-local venvs:"
  for v in .venv*; do
    if [ -d "$v" ]; then
      local pyver=$(grep -E 'version' "$v/pyvenv.cfg" 2>/dev/null | sed 's/ *version *= *//')
      echo "  - $v ($pyver)"
    fi
  done

  echo ""
  echo "⭐ Currently active:"
  echo "  - VIRTUAL_ENV=${VIRTUAL_ENV:-<none>}"
  python --version 2>/dev/null || echo "  - Python: <none>"
}

