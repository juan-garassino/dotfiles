# Secrets — keys live in ~/.secrets (chmod 600, outside any repo). Never commit.
.secrets
!.secrets.sample
*.secret
*.env
.env*
!.env.example
*-*.json.key
*service-account*.json
*.pem
# private keys (id_ed25519, id_migrate, …); public halves may be shared
id_*
!id_*.pub

# Claude Code local / runtime
claude/settings.local.json
claude/**/.DS_Store

# OS / editor noise
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Backups & logs
*.backup
*.tmp
*.log

# Generated artifacts (regenerated by custom_scripts)
custom_scripts/repos.json
custom_scripts/dashboard_out.html

# Claude skills that must never reach this PUBLIC repo
claude/skills/.trash/
claude/skills/synced/
claude/skills/post-as-me/
